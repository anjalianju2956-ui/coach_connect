# ============================================================
# Coach-Connect — environment variables
# ------------------------------------------------------------
# Copy this file to `.env` (backend) and `client/.env` (frontend).
# NEVER commit real keys. `.env` is git-ignored.
# ============================================================

# ---------- Backend (server/) ----------

# Port the Express API listens on
PORT=4000

# Where the React dev server runs (used for CORS in development)
CLIENT_ORIGIN=http://localhost:5173

# RailKit API key — https://railkit.in/dashboard
# Requests are ALWAYS made from the backend, never from the browser.
# Live RailKit requests are disabled by default; set true only when you intend
# to spend from the configured monthly request budget.
RAILKIT_ENABLED=false
RAILKIT_API_KEY=YOUR_RAILKIT_API_KEY
RAILKIT_MONTHLY_REQUEST_LIMIT=50

# Base URL for RailKit REST API (documented endpoints live under /api/v1)
RAILKIT_BASE_URL=https://api.railkit.in

# Optional hard timeout for RailKit calls (milliseconds)
RAILKIT_TIMEOUT_MS=8000

# ---------- Supabase ----------

# Project settings → API
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: server-side key for future Partner/admin operations.
# Leave empty for now. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Business rules ----------

# Verification confidence required to enter Train Mode (0 - 1)
VERIFY_THRESHOLD=0.65

# How far off the rail corridor a device may be and still count (km)
MAX_OFF_CORRIDOR_KM=12

# Serve clearly-marked DEMO stalls/routes when no real data exists.
# Set to false once real Partner data is seeded.
ENABLE_DEMO_DATA=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------- Frontend (client/.env) ----------
# The browser only ever sees VITE_* variables (public by design).
# VITE_API_URL is empty by default: Vite proxies /api in dev,
# and the Express server serves the built SPA in production.
#
#   client/.env:
#   VITE_API_URL=
#   VITE_SUPABASE_URL=YOUR_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
