# Copy to server/.env  (the server also reads a .env in the project root)
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
RAILKIT_ENABLED=false
RAILKIT_API_KEY=YOUR_RAILKIT_API_KEY
RAILKIT_BASE_URL=https://api.railkit.in
RAILKIT_TIMEOUT_MS=15000
RAILKIT_MONTHLY_REQUEST_LIMIT=50
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=
VERIFY_THRESHOLD=0.65
MAX_OFF_CORRIDOR_KM=12
SERVICE_FEE=0
ENABLE_DEMO_DATA=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
