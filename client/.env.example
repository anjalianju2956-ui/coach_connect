# Frontend environment (client/.env)
# VITE_* values are visible in the browser — never put secrets here.
# RAILKIT_API_KEY must NEVER appear in this file.

# Leave empty in development: Vite proxies /api to http://localhost:4000
VITE_API_URL=

# Supabase project settings -> API (anon key is publishable by design)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
